-- error: NULL required args, nonexistent column/view
BEGIN;
SAVEPOINT sp1;
SELECT deprecate_column(NULL, 'employee_summary', 'salary');
ERROR:  schema_name, view_name, and column_name must not be NULL
ROLLBACK TO sp1;
SAVEPOINT sp2;
SELECT deprecate_column('test_depr', NULL, 'salary');
ERROR:  schema_name, view_name, and column_name must not be NULL
ROLLBACK TO sp2;
SAVEPOINT sp3;
SELECT deprecate_column('test_depr', 'employee_summary', NULL);
ERROR:  schema_name, view_name, and column_name must not be NULL
ROLLBACK TO sp3;
SAVEPOINT sp4;
SELECT deprecate_column('test_depr', 'employee_summary', 'no_such_column');
ERROR:  column "no_such_column" not found on view "test_depr.employee_summary"
ROLLBACK TO sp4;
SAVEPOINT sp5;
SELECT deprecate_column('test_depr', 'no_such_view', 'salary');
ERROR:  column "salary" not found on view "test_depr.no_such_view"
ROLLBACK TO sp5;
COMMIT;
-- teardown
DROP SCHEMA test_depr CASCADE;
NOTICE:  drop cascades to 3 other objects
DETAIL:  drop cascades to table test_depr.employees
drop cascades to view test_depr.employee_summary
drop cascades to view test_depr.high_earners
